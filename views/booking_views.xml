<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequences -->
    <record id="seq_vanguard_booking" model="ir.sequence">
        <field name="name">Vanguard Booking Sequence</field>
        <field name="code">vanguard.booking</field>
        <field name="prefix">VB/</field>
        <field name="padding">5</field>
    </record>

    <!-- ─── FACILITY ──────────────────────────────────────────── -->
    <record id="view_facility_tree" model="ir.ui.view">
        <field name="name">vanguard.facility.tree</field>
        <field name="model">vanguard.facility</field>
        <field name="arch" type="xml">
            <tree decoration-info="state=='pending'" decoration-success="state=='approved'" decoration-muted="state=='rejected'">
                <field name="name"/>
                <field name="location"/>
                <field name="phone"/>
                <field name="state" widget="badge" decoration-info="state=='pending'" decoration-success="state=='approved'" decoration-danger="state=='rejected'"/>
                <field name="total_assets"/>
                <field name="total_customers"/>
                <field name="total_bookings_today"/>
            </tree>
        </field>
    </record>
    <record id="view_facility_form" model="ir.ui.view">
        <field name="name">vanguard.facility.form</field>
        <field name="model">vanguard.facility</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'pending')]}"/>
                    <button name="action_reject" string="Reject" type="object" attrs="{'invisible': [('state', 'in', ['rejected'])]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Contact">
                            <field name="location"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group string="Financial Breakdown">
                            <field name="revenue_mtd" widget="monetary"/>
                            <field name="booking_revenue_mtd" widget="monetary"/>
                            <field name="subscription_revenue_mtd" widget="monetary"/>
                            <field name="revenue_all_time" widget="monetary"/>
                            <field name="booking_revenue_all_time" widget="monetary"/>
                            <field name="subscription_revenue_all_time" widget="monetary"/>
                        </group>
                        <group string="Stats">
                            <field name="total_assets"/>
                            <field name="total_customers"/>
                            <field name="total_bookings_today"/>
                        </group>
                    </group>
                    <group string="Owner Credentials (App Login)">
                        <group>
                            <field name="owner_email" placeholder="owner@facility.com"/>
                            <field name="owner_phone" placeholder="9876543210"/>
                        </group>
                        <group>
                            <field name="owner_password" password="True"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Verification Proofs">
                            <group>
                                <group string="Documents &amp; Coordinates">
                                    <field name="company_registration_no"/>
                                    <field name="turf_location_coords"/>
                                    <field name="verification_doc_name" invisible="1"/>
                                    <field name="verification_doc" filename="verification_doc_name"/>
                                </group>
                                <group string="Turf Images (GPS Location Verified)">
                                    <field name="turf_img1" widget="image" options="{'size': [150, 150]}"/>
                                    <field name="turf_img2" widget="image" options="{'size': [150, 150]}"/>
                                    <field name="turf_img3" widget="image" options="{'size': [150, 150]}"/>
                                    <field name="turf_img4" widget="image" options="{'size': [150, 150]}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Sport Assets">
                            <field name="sport_asset_ids"><tree editable="bottom"><field name="sport_type"/><field name="count"/><field name="open_time" widget="float_time"/><field name="close_time" widget="float_time"/><field name="price_per_hour"/></tree></field>
                        </page>
                        <page string="Hourly Pricing Rules (Prime / Non-Prime)">
                            <field name="hourly_price_ids">
                                <tree editable="bottom" decoration-warning="rate_type=='prime'" decoration-info="rate_type=='non_prime'">
                                    <field name="sport_type"/>
                                    <field name="rate_type" widget="badge" decoration-warning="rate_type=='prime'" decoration-info="rate_type=='non_prime'"/>
                                    <field name="days_type"/>
                                    <field name="start_hour" widget="float_time"/>
                                    <field name="end_hour" widget="float_time"/>
                                    <field name="price"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Subscription Plans">
                            <field name="plan_ids"><tree><field name="name"/><field name="plan_type"/><field name="timing_type" widget="badge" decoration-warning="timing_type=='prime'" decoration-info="timing_type=='non_prime'"/><field name="duration_days"/><field name="price"/><field name="user_count"/><field name="gross_yield"/></tree></field>
                        </page>
                        <page string="Customers">
                            <field name="customer_ids"><tree><field name="name"/><field name="phone"/><field name="customer_type"/><field name="sport_type"/><field name="active_plan_name"/></tree></field>
                        </page>
                        <page string="Bookings">
                            <field name="booking_ids"><tree decoration-success="state=='confirmed'" decoration-danger="state=='cancelled'"><field name="name"/><field name="athlete_name"/><field name="sport_type"/><field name="booking_type"/><field name="booking_date"/><field name="start_time" widget="float_time"/><field name="end_time" widget="float_time"/><field name="price"/><field name="state"/></tree></field>
                        </page>
                        <page string="Tutors">
                            <field name="tutor_ids"><tree editable="bottom"><field name="name"/><field name="sport_type"/><field name="phone"/><field name="experience_years"/><field name="student_count" string="Students"/><field name="is_active"/></tree></field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="action_facility" model="ir.actions.act_window">
        <field name="name">Facilities</field><field name="res_model">vanguard.facility</field><field name="view_mode">tree,form</field>
    </record>

    <!-- ─── SUBSCRIPTION PLAN ────────────────────────────────── -->
    <record id="view_plan_tree" model="ir.ui.view">
        <field name="name">vanguard.subscription.plan.tree</field>
        <field name="model">vanguard.subscription.plan</field>
        <field name="arch" type="xml">
            <tree><field name="name"/><field name="facility_id"/><field name="plan_type"/><field name="timing_type" widget="badge" decoration-warning="timing_type=='prime'" decoration-info="timing_type=='non_prime'"/><field name="duration_days"/><field name="price"/><field name="user_count"/><field name="gross_yield"/><field name="renewals"/></tree>
        </field>
    </record>
    <record id="view_plan_form" model="ir.ui.view">
        <field name="name">vanguard.subscription.plan.form</field>
        <field name="model">vanguard.subscription.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="facility_id"/><field name="plan_type"/><field name="timing_type"/><field name="sport_type"/></group>
                        <group><field name="duration_days"/><field name="price"/><field name="user_count"/><field name="gross_yield" widget="monetary"/></group>
                    </group>
                    <notebook>
                        <page string="Subscriptions">
                            <field name="subscription_ids"><tree decoration-success="state=='active'" decoration-danger="state=='expired'"><field name="customer_id"/><field name="start_date"/><field name="end_date"/><field name="amount_paid"/><field name="payment_mode"/><field name="state"/></tree></field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_plan" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field><field name="res_model">vanguard.subscription.plan</field><field name="view_mode">tree,form</field>
    </record>

    <!-- ─── CUSTOMER ─────────────────────────────────────────── -->
    <record id="view_customer_tree" model="ir.ui.view">
        <field name="name">vanguard.customer.tree</field>
        <field name="model">vanguard.customer</field>
        <field name="arch" type="xml">
            <tree decoration-success="approval_status=='approved'" decoration-warning="approval_status=='pending'" decoration-danger="approval_status=='rejected'">
                <field name="name"/><field name="phone"/><field name="facility_id"/><field name="customer_type"/><field name="approval_status" widget="badge" decoration-success="approval_status=='approved'" decoration-warning="approval_status=='pending'" decoration-danger="approval_status=='rejected'"/><field name="sport_type"/><field name="active_plan_name"/><field name="active_plan_amount"/><field name="is_expired"/>
            </tree>
        </field>
    </record>
    <record id="view_customer_form" model="ir.ui.view">
        <field name="name">vanguard.customer.form</field>
        <field name="model">vanguard.customer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve_customer" string="Approve Customer" type="object" class="oe_highlight" attrs="{'invisible': [('approval_status', '=', 'approved')]}"/>
                    <button name="action_reject_customer" string="Reject" type="object" class="btn-danger" attrs="{'invisible': [('approval_status', '=', 'rejected')]}"/>
                    <button name="action_reset_customer_pending" string="Reset to Pending" type="object" attrs="{'invisible': [('approval_status', '=', 'pending')]}"/>
                    <field name="approval_status" widget="statusbar" statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="phone"/><field name="facility_id"/><field name="customer_type"/><field name="approval_status"/><field name="sport_type"/></group>
                        <group><field name="rejection_reason" attrs="{'invisible': [('approval_status', '!=', 'rejected')]}"/><!-- <field name="coaching_level" attrs="{'invisible': [('customer_type', '!=', 'student')]}"/> --><field name="coach_assigned" attrs="{'invisible': [('customer_type', '!=', 'student')]}"/><field name="court_assignment" attrs="{'invisible': [('customer_type', '!=', 'student')]}"/><field name="tutor_id" attrs="{'invisible': [('customer_type', '!=', 'student')]}"/></group>
                    </group>
                    <notebook>
                        <page string="Subscriptions">
                            <field name="subscription_ids"><tree editable="bottom" decoration-success="state=='active'" decoration-danger="state=='expired'"><field name="plan_id"/><field name="sport_type"/><field name="start_date"/><field name="end_date"/><field name="amount_paid"/><field name="payment_mode"/><field name="receipt_date"/><field name="state"/><field name="is_renewal"/></tree></field>
                        </page>
                        <page string="Bookings">
                            <field name="booking_ids"><tree decoration-success="state=='confirmed'"><field name="name"/><field name="sport_type"/><field name="booking_date"/><field name="start_time" widget="float_time"/><field name="end_time" widget="float_time"/><field name="price"/><field name="state"/></tree></field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="action_customer" model="ir.actions.act_window">
        <field name="name">Customers</field><field name="res_model">vanguard.customer</field><field name="view_mode">tree,form</field>
    </record>

    <!-- ─── BOOKING ───────────────────────────────────────────── -->
    <record id="view_booking_tree" model="ir.ui.view">
        <field name="name">vanguard.booking.tree</field>
        <field name="model">vanguard.booking</field>
        <field name="arch" type="xml">
            <tree decoration-info="state=='draft'" decoration-success="state=='confirmed'" decoration-danger="state=='cancelled'">
                <field name="name"/><field name="facility_id"/><field name="athlete_name"/><field name="sport_type"/><field name="booking_type"/><field name="court_number"/><field name="booking_date"/><field name="start_time" widget="float_time"/><field name="end_time" widget="float_time"/><field name="price"/><field name="state"/><field name="cancellation_reason" optional="show"/>
            </tree>
        </field>
    </record>
    <record id="view_booking_form" model="ir.ui.view">
        <field name="name">vanguard.booking.form</field>
        <field name="model">vanguard.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" states="draft"/>
                    <button name="action_cancel" string="Cancel" type="object" states="draft,confirmed"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group><field name="facility_id"/><field name="customer_id"/><field name="athlete_name"/><field name="phone"/><field name="booking_type"/></group>
                        <group><field name="sport_type"/><field name="sport_asset_id"/><field name="court_number"/><field name="booking_date"/><field name="start_time" widget="float_time"/><field name="end_time" widget="float_time"/><field name="price"/></group>
                    </group>
                    <group string="Cancellation Details" attrs="{'invisible': [('state', '!=', 'cancelled')]}">
                        <field name="cancellation_reason"/>
                        <field name="cancelled_by"/>
                        <field name="cancel_date"/>
                    </group>
                    <notebook>
                        <page string="Equipment Rentals">
                            <field name="rental_ids" context="{'default_facility_id': facility_id}">
                                <tree editable="bottom">
                                    <field name="facility_id" invisible="1"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="hourly_rate"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                    <field name="duration_hours"/>
                                    <field name="total_cost"/>
                                    <field name="payment_mode"/>
                                    <field name="state" widget="badge" decoration-warning="state=='draft'" decoration-info="state=='active'" decoration-success="state=='returned'" decoration-danger="state=='cancelled'"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="price" string="Court Fee (₹)" readonly="1"/>
                                <field name="rental_total" string="Equipment Rentals (₹)" readonly="1"/>
                                <field name="total_payable" string="Grand Total (₹)" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                    </notebook>
                    <group><field name="notes" colspan="2"/></group>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="action_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field><field name="res_model">vanguard.booking</field><field name="view_mode">tree,form</field>
    </record>

    <!-- ─── TUTOR ────────────────────────────────────────────── -->
    <record id="view_tutor_tree" model="ir.ui.view">
        <field name="name">vanguard.tutor.tree</field>
        <field name="model">vanguard.tutor</field>
        <field name="arch" type="xml">
            <tree decoration-muted="is_active==False">
                <field name="name"/><field name="facility_id"/><field name="sport_type"/><field name="phone"/><field name="experience_years"/><field name="student_count" string="Students"/><field name="is_active"/>
            </tree>
        </field>
    </record>
    <record id="view_tutor_form" model="ir.ui.view">
        <field name="name">vanguard.tutor.form</field>
        <field name="model">vanguard.tutor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="facility_id"/><field name="sport_type"/><field name="phone"/><field name="experience_years"/><field name="is_active"/></group>
                        <group><field name="bio" placeholder="Coaching background, certifications..."/></group>
                    </group>
                    <notebook>
                        <page string="Assigned Students">
                            <field name="student_ids"><tree><field name="name"/><field name="phone"/><!-- <field name="coaching_level"/> --><field name="sport_type"/><field name="active_plan_name"/></tree></field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_tutor" model="ir.actions.act_window">
        <field name="name">Tutors</field><field name="res_model">vanguard.tutor</field><field name="view_mode">tree,form</field>
    </record>

    <!-- ─── COACHING CLASS ────────────────────────────────────── -->
    <record id="view_coaching_class_tree" model="ir.ui.view">
        <field name="name">vanguard.coaching.class.tree</field>
        <field name="model">vanguard.coaching.class</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="facility_id"/>
                <field name="sport_type"/>
                <field name="court_number"/>
                <field name="start_hour"/>
                <field name="end_hour"/>
            </tree>
        </field>
    </record>
    <record id="view_coaching_class_form" model="ir.ui.view">
        <field name="name">vanguard.coaching.class.form</field>
        <field name="model">vanguard.coaching.class</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="facility_id"/>
                            <field name="sport_type"/>
                            <field name="court_number"/>
                        </group>
                        <group>
                            <field name="start_hour"/>
                            <field name="end_hour"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_coaching_class" model="ir.actions.act_window">
        <field name="name">Student Class Times</field>
        <field name="res_model">vanguard.coaching.class</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ─── INVENTORY / PRODUCTS ─────────────────────────────── -->
    <record id="view_vanguard_product_tree" model="ir.ui.view">
        <field name="name">vanguard.product.tree</field>
        <field name="model">vanguard.product</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="facility_id"/>
                <field name="category"/>
                <field name="product_type" widget="badge" decoration-info="product_type=='rent'" decoration-success="product_type=='sale'" decoration-warning="product_type=='both'"/>
                <field name="sale_price" attrs="{'invisible': [('product_type', '=', 'rent')]}"/>
                <field name="rental_price_per_hour" attrs="{'invisible': [('product_type', '=', 'sale')]}"/>
                <field name="cost_price"/>
                <field name="min_stock_alert" invisible="1"/>
                <field name="stock_qty" decoration-danger="stock_qty &lt;= min_stock_alert" decoration-success="stock_qty &gt; min_stock_alert"/>
                <field name="currently_rented_qty"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>
    <record id="view_vanguard_product_form" model="ir.ui.view">
        <field name="name">vanguard.product.form</field>
        <field name="model">vanguard.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Product Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="facility_id"/>
                            <field name="category"/>
                            <field name="product_type"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="sale_price" attrs="{'invisible': [('product_type', '=', 'rent')]}"/>
                            <field name="rental_price_per_hour" attrs="{'invisible': [('product_type', '=', 'sale')]}"/>
                            <field name="cost_price"/>
                            <field name="stock_qty"/>
                            <field name="min_stock_alert"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Restock History" attrs="{'invisible': [('product_type', '=', 'rent')]}">
                            <field name="purchase_ids">
                                <tree>
                                    <field name="purchase_date"/>
                                    <field name="quantity"/>
                                    <field name="unit_cost"/>
                                    <field name="total_cost"/>
                                    <field name="supplier_name"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Rental History" attrs="{'invisible': [('product_type', '=', 'sale')]}">
                            <field name="rental_ids" readonly="1">
                                <tree decoration-info="state=='active'" decoration-success="state=='returned'" decoration-muted="state=='cancelled'">
                                    <field name="rent_date"/>
                                    <field name="customer_name"/>
                                    <field name="customer_phone"/>
                                    <field name="booking_id"/>
                                    <field name="quantity"/>
                                    <field name="hourly_rate"/>
                                    <field name="duration_hours"/>
                                    <field name="total_cost"/>
                                    <field name="state" widget="badge" decoration-warning="state=='draft'" decoration-info="state=='active'" decoration-success="state=='returned'" decoration-danger="state=='cancelled'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_vanguard_product" model="ir.actions.act_window">
        <field name="name">Products / Inventory</field>
        <field name="res_model">vanguard.product</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ─── RESTOCK PURCHASES ──────────────────────────────────── -->
    <record id="view_vanguard_inventory_purchase_tree" model="ir.ui.view">
        <field name="name">vanguard.inventory.purchase.tree</field>
        <field name="model">vanguard.inventory.purchase</field>
        <field name="arch" type="xml">
            <tree>
                <field name="purchase_date"/>
                <field name="facility_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="unit_cost"/>
                <field name="total_cost"/>
                <field name="supplier_name"/>
            </tree>
        </field>
    </record>
    <record id="action_vanguard_inventory_purchase" model="ir.actions.act_window">
        <field name="name">Restock Logs</field>
        <field name="res_model">vanguard.inventory.purchase</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ─── POS SALES ─────────────────────────────────────────── -->
    <record id="view_vanguard_sale_tree" model="ir.ui.view">
        <field name="name">vanguard.sale.tree</field>
        <field name="model">vanguard.sale</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state=='cancelled'" decoration-success="state=='done'">
                <field name="name"/>
                <field name="sale_date"/>
                <field name="facility_id"/>
                <field name="customer_name"/>
                <field name="customer_phone"/>
                <field name="payment_mode"/>
                <field name="total_amount"/>
                <field name="state" widget="badge" decoration-success="state=='done'" decoration-danger="state=='cancelled'"/>
            </tree>
        </field>
    </record>
    <record id="view_vanguard_sale_form" model="ir.ui.view">
        <field name="name">vanguard.sale.form</field>
        <field name="model">vanguard.sale</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cancel_sale" string="Cancel &amp; Restore Stock" type="object" attrs="{'invisible': [('state', '!=', 'done')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="facility_id"/>
                            <field name="customer_name"/>
                            <field name="customer_phone"/>
                        </group>
                        <group>
                            <field name="sale_date"/>
                            <field name="payment_mode"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sale Items">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_vanguard_sale" model="ir.actions.act_window">
        <field name="name">Counter Sales (POS)</field>
        <field name="res_model">vanguard.sale</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ─── EXPENSES ──────────────────────────────────────────── -->
    <record id="view_vanguard_expense_tree" model="ir.ui.view">
        <field name="name">vanguard.expense.tree</field>
        <field name="model">vanguard.expense</field>
        <field name="arch" type="xml">
            <tree>
                <field name="expense_date"/>
                <field name="name"/>
                <field name="facility_id"/>
                <field name="category"/>
                <field name="amount"/>
                <field name="payment_mode"/>
            </tree>
        </field>
    </record>
    <record id="view_vanguard_expense_form" model="ir.ui.view">
        <field name="name">vanguard.expense.form</field>
        <field name="model">vanguard.expense</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Expense Title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="facility_id"/>
                            <field name="category"/>
                            <field name="expense_date"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="payment_mode"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_vanguard_expense" model="ir.actions.act_window">
        <field name="name">Facility Expenses</field>
        <field name="res_model">vanguard.expense</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ─── EQUIPMENT RENTALS ──────────────────────────────────── -->
    <record id="view_vanguard_rental_tree" model="ir.ui.view">
        <field name="name">vanguard.rental.tree</field>
        <field name="model">vanguard.rental</field>
        <field name="arch" type="xml">
            <tree decoration-info="state=='active'" decoration-success="state=='returned'" decoration-muted="state=='cancelled'">
                <field name="rent_date"/>
                <field name="facility_id"/>
                <field name="product_id"/>
                <field name="customer_name"/>
                <field name="customer_phone"/>
                <field name="booking_id"/>
                <field name="quantity"/>
                <field name="hourly_rate"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="duration_hours"/>
                <field name="total_cost"/>
                <field name="payment_mode"/>
                <field name="state" widget="badge" decoration-warning="state=='draft'" decoration-info="state=='active'" decoration-success="state=='returned'" decoration-danger="state=='cancelled'"/>
            </tree>
        </field>
    </record>
    <record id="view_vanguard_rental_form" model="ir.ui.view">
        <field name="name">vanguard.rental.form</field>
        <field name="model">vanguard.rental</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_rent_out" string="Rent Out Equipment" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_mark_returned" string="Mark as Returned" type="object" class="btn-success" attrs="{'invisible': [('state', '!=', 'active')]}"/>
                    <button name="action_cancel_rental" string="Cancel Rental" type="object" attrs="{'invisible': [('state', 'in', ['returned', 'cancelled'])]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="product_id" placeholder="Select Equipment / Racket"/></h1>
                    </div>
                    <group>
                        <group string="Facility &amp; Booking Info">
                            <field name="facility_id"/>
                            <field name="booking_id"/>
                            <field name="customer_id"/>
                            <field name="customer_name"/>
                            <field name="customer_phone"/>
                        </group>
                        <group string="Rental Time &amp; Duration">
                            <field name="rent_date"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="duration_hours"/>
                        </group>
                    </group>
                    <group>
                        <group string="Pricing &amp; Cost">
                            <field name="quantity"/>
                            <field name="hourly_rate"/>
                            <field name="total_cost"/>
                        </group>
                        <group string="Payment &amp; Details">
                            <field name="payment_mode"/>
                            <field name="notes" placeholder="e.g. Condition on handover, racket serial #..."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_vanguard_rental" model="ir.actions.act_window">
        <field name="name">Equipment Rentals</field>
        <field name="res_model">vanguard.rental</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ─── MENUS ─────────────────────────────────────────────── -->
    <menuitem id="menu_root" name="Vanguard"/>
    <menuitem id="menu_facilities" name="Facilities" parent="menu_root" action="action_facility"/>
    <menuitem id="menu_bookings" name="Bookings" parent="menu_root" action="action_booking"/>
    <menuitem id="menu_customers" name="Customers" parent="menu_root" action="action_customer"/>
    <menuitem id="menu_plans" name="Subscription Plans" parent="menu_root" action="action_plan"/>
    <menuitem id="menu_tutors" name="Tutors" parent="menu_root" action="action_tutor"/>
    <menuitem id="menu_coaching_classes" name="Student Class Times" parent="menu_root" action="action_coaching_class"/>
    <menuitem id="menu_inventory" name="Inventory" parent="menu_root" action="action_vanguard_product"/>
    <menuitem id="menu_rentals" name="Rentals" parent="menu_root" action="action_vanguard_rental"/>
    <menuitem id="menu_sales" name="Counter Sales" parent="menu_root" action="action_vanguard_sale"/>
    <menuitem id="menu_expenses" name="Expenses" parent="menu_root" action="action_vanguard_expense"/>
</odoo>